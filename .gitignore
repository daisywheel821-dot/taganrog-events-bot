.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# PyCharm / IntelliJ IDEA
.idea/

# Текстовые редакторы (Vim, Emacs и др.)
*.swp
*.swo
*~

# ==========================================
