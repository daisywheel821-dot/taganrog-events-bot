*.py[cod]
*$py.class
*.so

# Директории виртуальных окружений
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/

# Файлы дистрибуции и сборки
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
